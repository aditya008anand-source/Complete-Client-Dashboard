{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/sheet",
      "destination": "/api/sheet.js"
    },
    {
      "source": "/api/weekly-report",
      "destination": "/api/weekly-report.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/sheet.js": {
      "maxDuration": 10
    },
    "api/weekly-report.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/weekly-report",
      "schedule": "30 0 * * 1"
    }
  ]
}
